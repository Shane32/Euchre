{
  "schemaVersion": "card-game-definition/1.0",
  "gameType": "euchre",
  "rulesVersion": "standard-24/1.2",
  "displayName": "Euchre",
  "playerConfiguration": {
    "minimumPlayers": 4,
    "maximumPlayers": 4,
    "seats": [1, 2, 3, 4],
    "teams": [
      { "teamId": 1, "seatIds": [1, 3] },
      { "teamId": 2, "seatIds": [2, 4] }
    ],
    "turnOrder": [1, 2, 3, 4],
    "allowSpectators": true,
    "allowJoinInProgress": false
  },
  "options": {
    "targetScore": { "type": "integer", "default": 10, "minimum": 1, "maximum": 21 },
    "stickTheDealer": { "type": "boolean", "default": false },
    "ankle": { "type": "boolean", "default": false },
    "aceNoFaceRedeal": { "type": "boolean", "default": false }
  },
  "cardSet": {
    "copies": 1,
    "suits": [
      { "id": "clubs", "symbol": "C", "color": "black" },
      { "id": "diamonds", "symbol": "D", "color": "red" },
      { "id": "hearts", "symbol": "H", "color": "red" },
      { "id": "spades", "symbol": "S", "color": "black" }
    ],
    "ranks": [
      { "id": "nine", "symbol": "9", "baseOrder": 0 },
      { "id": "ten", "symbol": "10", "baseOrder": 1 },
      { "id": "jack", "symbol": "J", "baseOrder": 2 },
      { "id": "queen", "symbol": "Q", "baseOrder": 3 },
      { "id": "king", "symbol": "K", "baseOrder": 4 },
      { "id": "ace", "symbol": "A", "baseOrder": 5 }
    ],
    "construction": { "kind": "cartesianProduct", "cardIdFormat": "{rank}.{suit}" }
  },
  "pileDefinitions": [
    {
      "id": "deck", "kind": "stock", "instantiate": "once", "owner": "server",
      "ordered": true, "top": "first", "select": "top",
      "visibility": { "existence": "public", "count": "none", "cards": "none", "order": "none" },
      "initialization": { "cards": "all", "shuffle": "seeded" }
    },
    {
      "id": "hand", "kind": "hand", "instantiate": "perSeat", "owner": "seat",
      "ordered": false, "select": "any",
      "visibility": { "existence": "public", "count": "public", "cards": "ownerOrKnown", "order": "owner" }
    },
    {
      "id": "kitty", "kind": "kitty", "instantiate": "once", "owner": "server",
      "ordered": true, "top": "first", "select": "euchreKitty",
      "visibility": { "existence": "public", "count": "public", "cards": "faceUpOrKnown", "order": "visibleCardPositions" }
    },
    {
      "id": "currentTrick", "kind": "trick", "instantiate": "once", "owner": "shared",
      "ordered": true, "top": "last", "select": "none",
      "visibility": { "existence": "public", "count": "public", "cards": "public", "order": "public" }
    },
    {
      "id": "won", "kind": "capture", "instantiate": "perTeam", "owner": "team",
      "ordered": false, "select": "none",
      "visibility": { "existence": "public", "count": "public", "cards": "known", "order": "none" }
    }
  ],
  "stateVariables": [
    { "name": "upcardInstanceId", "type": "cardInstanceId", "default": null, "nullable": true, "visibility": "known" },
    { "name": "biddingRound", "type": "integer", "default": 0, "minimum": 0, "maximum": 2, "visibility": "public" },
    { "name": "makerSeat", "type": "seatId", "default": null, "nullable": true, "visibility": "public" },
    { "name": "trump", "type": "suitId", "default": null, "nullable": true, "visibility": "public" },
    { "name": "noTrump", "type": "boolean", "default": false, "visibility": "public" },
    { "name": "aloneSeat", "type": "seatId", "default": null, "nullable": true, "visibility": "public" },
    { "name": "inactiveSeat", "type": "seatId", "default": null, "nullable": true, "visibility": "public" },
    { "name": "orderedUp", "type": "boolean", "default": false, "visibility": "public" },
    { "name": "tricksPlayed", "type": "integer", "default": 0, "minimum": 0, "maximum": 5, "visibility": "public" }
  ],
  "phases": [
    { "id": "waiting", "mode": "simultaneous", "actors": "allPlayers", "allowedActions": ["ready"], "completionHandler": "handler:euchre.allPlayersReady" },
    { "id": "deal", "mode": "automatic", "actors": "system", "allowedActions": ["deal"], "completionHandler": "handler:euchre.beginFirstBiddingRound" },
    { "id": "bidRoundOne", "mode": "exclusiveTurn", "actors": "activeSeat", "allowedActions": ["pass", "orderUp", "claimAceNoFace"], "completionHandler": "handler:euchre.advanceFirstBiddingRound" },
    { "id": "dealerDiscard", "mode": "exclusiveTurn", "actors": "dealer", "allowedActions": ["discard"], "completionHandler": "handler:euchre.beginPlayAfterDiscard" },
    { "id": "bidRoundTwo", "mode": "exclusiveTurn", "actors": "activeSeat", "allowedActions": ["pass", "chooseTrump", "chooseNoTrump"], "completionHandler": "handler:euchre.advanceSecondBiddingRound" },
    { "id": "play", "mode": "exclusiveTurn", "actors": "activeSeat", "allowedActions": ["playCard"], "completionHandler": "handler:euchre.advanceTrickOrScore" },
    { "id": "scoreDeal", "mode": "automatic", "actors": "system", "allowedActions": ["scoreDeal"], "completionHandler": "handler:euchre.nextDealOrComplete" },
    { "id": "completed", "mode": "automatic", "actors": "none", "allowedActions": [], "completionHandler": "handler:core.never" }
  ],
  "actions": [
    { "id": "ready", "transport": "other", "phases": ["waiting"], "actor": "self", "arguments": { "type": "object" }, "validationHandler": "handler:core.seatedPlayer", "applyHandler": "handler:core.markReady", "visibility": "public" },
    { "id": "deal", "transport": "system", "phases": ["deal"], "actor": "system", "arguments": { "type": "object" }, "validationHandler": "handler:core.systemOnly", "applyHandler": "handler:euchre.dealFiveAndTurnUp", "visibility": "deal" },
    { "id": "pass", "transport": "other", "phases": ["bidRoundOne", "bidRoundTwo"], "actor": "activeSeat", "arguments": { "type": "object" }, "validationHandler": "handler:euchre.canPass", "applyHandler": "handler:euchre.applyPass", "visibility": "public" },
    { "id": "orderUp", "transport": "other", "phases": ["bidRoundOne"], "actor": "activeSeat", "arguments": { "type": "object", "properties": { "alone": { "type": "boolean" } } }, "validationHandler": "handler:euchre.canOrderUp", "applyHandler": "handler:euchre.applyOrderUp", "visibility": "public" },
    { "id": "claimAceNoFace", "transport": "other", "phases": ["bidRoundOne"], "actor": "activeSeat", "arguments": { "type": "object" }, "validationHandler": "handler:euchre.canClaimAceNoFace", "applyHandler": "handler:euchre.redeal", "visibility": "public" },
    { "id": "chooseTrump", "transport": "other", "phases": ["bidRoundTwo"], "actor": "activeSeat", "arguments": { "type": "object", "required": ["suit"], "properties": { "suit": { "type": "string" }, "alone": { "type": "boolean" } } }, "validationHandler": "handler:euchre.canChooseTrump", "applyHandler": "handler:euchre.applyChooseTrump", "visibility": "public" },
    { "id": "chooseNoTrump", "transport": "other", "phases": ["bidRoundTwo"], "actor": "activeSeat", "arguments": { "type": "object", "properties": { "alone": { "type": "boolean" } } }, "validationHandler": "handler:euchre.canChooseNoTrump", "applyHandler": "handler:euchre.applyChooseNoTrump", "visibility": "public" },
    { "id": "discard", "transport": "playCard", "phases": ["dealerDiscard"], "actor": "dealer", "arguments": { "sourcePile": "hand", "targetPile": "kitty" }, "validationHandler": "handler:euchre.canDealerDiscard", "applyHandler": "handler:euchre.applyDealerDiscard", "visibility": "discard" },
    { "id": "playCard", "transport": "playCard", "phases": ["play"], "actor": "activeSeat", "arguments": { "sourcePile": "hand", "targetPile": "currentTrick" }, "validationHandler": "handler:euchre.canPlayCard", "applyHandler": "handler:euchre.applyPlayCardAndResolveTrick", "visibility": "public" },
    { "id": "scoreDeal", "transport": "system", "phases": ["scoreDeal"], "actor": "system", "arguments": { "type": "object" }, "validationHandler": "handler:core.systemOnly", "applyHandler": "handler:euchre.scoreDeal", "visibility": "public" }
  ],
  "cardRules": {
    "effectiveSuitHandler": "handler:euchre.effectiveSuitWithLeftBower",
    "followSuitHandler": "handler:euchre.mustFollowEffectiveSuit",
    "trickWinnerHandler": "handler:euchre.trickWinner",
    "trumpOrder": ["rightBower", "leftBower", "ace", "king", "queen", "ten", "nine"],
    "plainSuitOrder": ["ace", "king", "queen", "jack", "ten", "nine"]
  },
  "scoring": {
    "scope": "team",
    "targetOption": "targetScore",
    "outcomes": [
      { "condition": "makers.notAlone.win3or4", "makerPoints": 1, "defenderPoints": 0 },
      { "condition": "makers.notAlone.win5", "makerPoints": 2, "defenderPoints": 0 },
      { "condition": "aloneMaker.win3or4", "makerPoints": 1, "defenderPoints": 0 },
      { "condition": "aloneMaker.win5", "makerPoints": 4, "defenderPoints": 0 },
      { "condition": "makers.win0to2", "makerPoints": 0, "defenderPoints": 2 }
    ],
    "handler": "handler:euchre.scoreDeal"
  },
  "extensions": {
    "euchre": {
      "firstBidder": "leftOfDealer",
      "secondRoundForbiddenSuit": "upcardSuit",
      "ankle": "dealer may choose a suit, choose no trump, or pass after the other second-round bidders pass",
      "aceNoFaceDefinition": "exactly one ace and no jacks, queens, or kings"
    }
  }
}

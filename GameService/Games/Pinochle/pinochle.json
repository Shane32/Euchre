{
  "schemaVersion": "card-game-definition/1.0",
  "gameType": "pinochle",
  "rulesVersion": "partnership-48/1.1",
  "displayName": "Partnership Pinochle",
  "playerConfiguration": {
    "minimumPlayers": 4,
    "maximumPlayers": 4,
    "seats": [1, 2, 3, 4],
    "teams": [
      { "teamId": 1, "seatIds": [1, 3] },
      { "teamId": 2, "seatIds": [2, 4] }
    ],
    "turnOrder": [1, 2, 3, 4],
    "allowSpectators": true,
    "allowJoinInProgress": false
  },
  "options": {
    "minimumBid": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 },
    "targetScore": { "type": "integer", "default": 150, "minimum": 1, "maximum": 1000 },
    "requireTrumpMarriage": { "type": "boolean", "default": true },
    "marriageScoring": {
      "type": "string",
      "default": "standard",
      "enum": ["standard", "doubleMarriageBonus"]
    }
  },
  "cardSet": {
    "copies": 2,
    "suits": [
      { "id": "clubs", "symbol": "C", "color": "black" },
      { "id": "diamonds", "symbol": "D", "color": "red" },
      { "id": "hearts", "symbol": "H", "color": "red" },
      { "id": "spades", "symbol": "S", "color": "black" }
    ],
    "ranks": [
      { "id": "nine", "symbol": "9", "baseOrder": 0 },
      { "id": "jack", "symbol": "J", "baseOrder": 1 },
      { "id": "queen", "symbol": "Q", "baseOrder": 2 },
      { "id": "king", "symbol": "K", "baseOrder": 3 },
      { "id": "ten", "symbol": "10", "baseOrder": 4 },
      { "id": "ace", "symbol": "A", "baseOrder": 5 }
    ],
    "construction": { "kind": "cartesianProduct", "cardIdFormat": "{rank}.{suit}" }
  },
  "pileDefinitions": [
    {
      "id": "deck", "kind": "stock", "instantiate": "once", "owner": "server",
      "ordered": true, "top": "first", "select": "top",
      "visibility": { "existence": "public", "count": "none", "cards": "none", "order": "none" },
      "initialization": { "cards": "all", "shuffle": "seeded" }
    },
    {
      "id": "hand", "kind": "hand", "instantiate": "perSeat", "owner": "seat",
      "ordered": false, "select": "any",
      "visibility": { "existence": "public", "count": "public", "cards": "ownerOrKnown", "order": "owner" }
    },
    {
      "id": "currentTrick", "kind": "trick", "instantiate": "once", "owner": "shared",
      "ordered": true, "top": "last", "select": "none",
      "visibility": { "existence": "public", "count": "public", "cards": "public", "order": "public" }
    },
    {
      "id": "won", "kind": "capture", "instantiate": "perTeam", "owner": "team",
      "ordered": false, "select": "none",
      "visibility": { "existence": "public", "count": "public", "cards": "known", "order": "none" }
    }
  ],
  "stateVariables": [
    { "name": "trump", "type": "suitId", "default": null, "nullable": true, "visibility": "public" },
    { "name": "bidderSeat", "type": "seatId", "default": null, "nullable": true, "visibility": "public" },
    { "name": "tricksPlayed", "type": "integer", "default": 0, "minimum": 0, "maximum": 12, "visibility": "public" }
  ],
  "phases": [
    { "id": "waiting", "mode": "simultaneous", "actors": "allPlayers", "allowedActions": ["ready"], "completionHandler": "handler:pinochle.allPlayersReady" },
    { "id": "deal", "mode": "automatic", "actors": "system", "allowedActions": ["deal"], "completionHandler": "handler:pinochle.beginBidding" },
    { "id": "bidding", "mode": "exclusiveTurn", "actors": "activeSeat", "allowedActions": ["bid", "pass"], "completionHandler": "handler:pinochle.advanceBidding" },
    { "id": "chooseTrump", "mode": "exclusiveTurn", "actors": "declarer", "allowedActions": ["chooseTrump"], "completionHandler": "handler:pinochle.scoreMeldAndBeginPlay" },
    { "id": "play", "mode": "exclusiveTurn", "actors": "activeSeat", "allowedActions": ["playCard"], "completionHandler": "handler:pinochle.advanceTrickOrScore" },
    { "id": "scoreDeal", "mode": "automatic", "actors": "system", "allowedActions": ["scoreDeal"], "completionHandler": "handler:pinochle.nextDealOrComplete" },
    { "id": "completed", "mode": "automatic", "actors": "none", "allowedActions": [], "completionHandler": "handler:core.never" }
  ],
  "actions": [
    { "id": "ready", "transport": "other", "phases": ["waiting"], "actor": "self", "arguments": { "type": "object" }, "validationHandler": "handler:core.seatedPlayer", "applyHandler": "handler:core.markReady", "visibility": "public" },
    { "id": "deal", "transport": "system", "phases": ["deal"], "actor": "system", "arguments": { "type": "object" }, "validationHandler": "handler:core.systemOnly", "applyHandler": "handler:pinochle.dealTwelve", "visibility": "deal" },
    { "id": "bid", "transport": "other", "phases": ["bidding"], "actor": "activeSeat", "arguments": { "type": "object", "required": ["value"], "properties": { "value": { "type": "integer" } } }, "validationHandler": "handler:pinochle.canBid", "applyHandler": "handler:pinochle.applyBid", "visibility": "public" },
    { "id": "pass", "transport": "other", "phases": ["bidding"], "actor": "activeSeat", "arguments": { "type": "object" }, "validationHandler": "handler:pinochle.canPass", "applyHandler": "handler:pinochle.applyPass", "visibility": "public" },
    { "id": "chooseTrump", "transport": "other", "phases": ["chooseTrump"], "actor": "declarer", "arguments": { "type": "object", "required": ["suit"], "properties": { "suit": { "type": "string" } } }, "validationHandler": "handler:pinochle.canChooseTrump", "applyHandler": "handler:pinochle.applyTrumpAndMeld", "visibility": "public" },
    { "id": "playCard", "transport": "playCard", "phases": ["play"], "actor": "activeSeat", "arguments": { "sourcePile": "hand", "targetPile": "currentTrick" }, "validationHandler": "handler:pinochle.canPlayCard", "applyHandler": "handler:pinochle.applyPlayCardAndResolveTrick", "visibility": "public" },
    { "id": "scoreDeal", "transport": "system", "phases": ["scoreDeal"], "actor": "system", "arguments": { "type": "object" }, "validationHandler": "handler:core.systemOnly", "applyHandler": "handler:pinochle.scoreDeal", "visibility": "public" }
  ],
  "cardRules": {
    "followSuitHandler": "handler:pinochle.mustFollowBeatAndTrump",
    "trickWinnerHandler": "handler:pinochle.trickWinner",
    "trumpOrder": ["ace", "ten", "king", "queen", "jack", "nine"],
    "plainSuitOrder": ["ace", "ten", "king", "queen", "jack", "nine"]
  },
  "scoring": { "scope": "team", "targetOption": "targetScore", "handler": "handler:pinochle.scoreDeal" },
  "extensions": {
    "pinochle": {
      "cardPointRanks": ["ace", "ten", "king"],
      "lastTrickBonus": 1,
      "meldValues": {
        "run": 15,
        "doubleRun": 150,
        "royalMarriage": 4,
        "doubleRoyalMarriage": 12,
        "doubleRoyalMarriageWithRun": 8,
        "marriage": 2,
        "doubleMarriage": 6,
        "pinochle": 4,
        "doublePinochle": 30,
        "acesAround": 10,
        "doubleAcesAround": 100,
        "kingsAround": 8,
        "doubleKingsAround": 80,
        "queensAround": 6,
        "doubleQueensAround": 60,
        "jacksAround": 4,
        "doubleJacksAround": 40,
        "dix": 1
      }
    }
  }
}
